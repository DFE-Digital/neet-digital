{% extends "views/manage-prototype/layout.njk" %}

{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set serviceName %}
{% endset %}

{% block pageTitle %}
  {% if error == "wrong-password" %}
    Error:
  {% endif %}
  Sign in - GOV.UK Prototype Kit
{% endblock %}


{% block header %}{% endblock %}
{% block footer %}{% endblock %}
{% block beforeContent %}{% endblock %}
{% block stylesheets %}
{{ super() }}
<style>
  .govuk-heading-xl, 
  .govuk-label, 
  .govuk-button, 
  .govuk-error-summary__title, 
  .govuk-error-summary__body, 
  .govuk-error-summary__list a,
  .govuk-error-message {
    font-family: sans-serif;
  }
</style>
{% endblock %}

{% block content %}

<form method="post" action="/manage-prototype/password">
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">

      {% if error == "wrong-password" %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [
            {
              text: "The password is not correct",
              href: "#password"
            }
          ]
        })}}
      {% endif %}

      <h1 class="govuk-heading-xl">
       Try our new service 
      </h1>

   <p class="govuk-body">
       We’ve created a prototype for you to try. This is a test version of a service we’re developing. Some parts may not work as expected. 
      </p>

       <p class="govuk-body">We’d like you to try the service and tell us what you think.  </p>

       
       <p class="govuk-body">As you use the service, we’d like your feedback on:  </p>

       <ul class="govuk-list govuk-list--bullet">
       <li>what works well </li>
       <li>what does not work well </li>
       <li>whether the service would be useful for you  </li>
       </ul>
       
        <p class="govuk-body">We’ll use your feedback to help us improve the service for young people.</p>
        <p class="govuk-body">We're also testing how accessible the service is. If you experience any accessibility barriers, use the feedback form to tell us about them. You’ll find a link to the form at the top and bottom of every page.</p>

      {{ govukInput({
        classes: "govuk-input--width-10",
        name: "password",
        id: "password",
        type: "password",
        hint: {
          text: "Enter password"
        },
        errorMessage: {
          text: "The password is not correct"
        } if error == "wrong-password",
        label:{
            html: 'Password: <strong>help</strong>'
        }
      }) }}

      <input type="hidden" name="returnURL" value="{{returnURL}}">

      {{ govukButton({
        text: "Continue"
      }) }}
    </div>
  </div>
</form>

{% endblock %}
